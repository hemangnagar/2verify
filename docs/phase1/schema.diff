+
+/// The five one-pager tiers. Prices in cents. Seeded, not user-editable in the POC.
+model Plan {
+  id               String @id @default(cuid())
+  name             String @unique
+  annualPriceCents Int    @map("annual_price_cents")
+  creditsPerYear   Int    @map("credits_per_year")
+  overageCents     Int    @map("overage_cents") // per credit past the allotment
+  sortOrder        Int    @default(0) @map("sort_order")
+
+  orgs Org[]
+
+  @@map("plan")
+}
+
+/// A customer pharmacy group. Every domain row belongs to exactly one org.
+model Org {
+  id               String    @id @default(cuid())
+  name             String
+  slug             String    @unique
+  planId           String    @map("plan_id")
+  status           OrgStatus @default(trial)
+  /// Subscribed jurisdictions (2-letter codes), billed at the per-state fee. Max 51.
+  subscribedStates String[]  @default([]) @map("subscribed_states")
+  /// Start of the current subscription year; credits and the usage page count from here.
+  termStartsOn     DateTime  @map("term_starts_on") @db.Date
+  isDemo           Boolean   @default(false) @map("is_demo")
+  createdAt        DateTime  @default(now()) @map("created_at")
+  updatedAt        DateTime  @updatedAt @map("updated_at")
+
+  plan             Plan             @relation(fields: [planId], references: [id])
+  users            User[]
+  entities         Entity[]
+  people           Person[]
+  credentials      Credential[]
+  verifications    Verification[]
+  screeningRuns    ScreeningRun[]
+  screeningMatches ScreeningMatch[]
+  alerts           Alert[]
+  auditEntries     AuditLog[]
+  ledger           CreditLedger[]
+
+  @@map("org")
+}
+
+/// INSERT ONLY (trigger). One row per credit movement; balance_after is the running balance.
+/// Invariant (tested): for every org, sum(delta) == balance_after of the newest row.
+model CreditLedger {
+  id             String       @id @default(cuid())
+  orgId          String       @map("org_id")
+  delta          Int
+  reason         CreditReason
+  /// Set for reason = verification; unique, so a verification can never be charged twice.
+  verificationId String?      @unique @map("verification_id")
+  balanceAfter   Int          @map("balance_after")
+  note           String?
+  createdById    String?      @map("created_by") // null = system
+  createdAt      DateTime     @default(now()) @map("created_at")
+
+  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
+  verification Verification? @relation(fields: [verificationId], references: [id], onDelete: Restrict)
+  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: Restrict)
+
+  @@index([orgId, createdAt])
+  @@map("credit_ledger")
+}
+
