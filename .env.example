# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance

# --- App --------------------------------------------------------------------
# Public URL users open. Behind a Cloudflare Tunnel this is https://<hostname> and it must be set
# BEFORE `docker compose build` (it is baked in for server-action origin checks and file links).
APP_URL=http://localhost:3000
# Extra hostnames allowed to post forms, comma-separated (rarely needed).
APP_ALLOWED_ORIGINS=
# Cloudflare Tunnel token from Zero Trust → Networks → Tunnels (only for docker-compose.tunnel.yml)
CLOUDFLARE_TUNNEL_TOKEN=
# 32+ random chars; signs the session cookie.  openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
# Operator (2Verify staff) user created by `make seed`; kept by `make seed-wipe`.
SEED_OPERATOR_EMAIL=ops@2verify.example.com
SEED_OPERATOR_NAME="2Verify Operator"
SEED_OPERATOR_PASSWORD=operator1234
# Password for the demo org admins (admin@sierra / admin@harbor / admin@prairie .example.com)
SEED_ORG_ADMIN_PASSWORD=admin1234
# Extra recipient for every alert (the compliance lead). Comma-separated.
ALERT_CC=compliance@sierra-rx.example.com

# --- File storage -----------------------------------------------------------
# "s3" (MinIO locally, R2/S3 in prod) or "local" (writes under ./data/files; dev only)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=compliance-evidence
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=600
# "app" (default): file links go through /api/files and the app streams from the bucket.
# "presigned": links go straight to the bucket (bucket must be reachable from the browser).
FILE_LINKS=app
LOCAL_STORAGE_DIR=./data/files

# --- Email ------------------------------------------------------------------
# "smtp" sends; "log" prints to stdout instead (no mail server needed)
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Sierra Compliance <compliance@sierra-rx.example.com>"

# --- External sources -------------------------------------------------------
# NPPES lookups on save: "live" calls npiregistry.cms.hhs.gov; "off" skips; "fixture" fakes a
# matching response (demo only, never in production).
NPPES_MODE=live
# Monthly screening: "live" downloads the LEIE CSV and queries the SAM API; "fixture" uses the
# synthetic extracts in prisma/fixtures (demo only).
SCREENING_MODE=live
SAM_API_KEY=
# Automated board adapters (headless Chromium). "on" runs enabled adapters from the app and the
# nightly job; "off" leaves every board on the guided workbench. Optional PW_CHROMIUM_PATH points at
# an installed Chrome/Chromium instead of Playwright's download.
BOARD_ADAPTERS=on
PW_CHROMIUM_PATH=
BOARD_USER_AGENT="2Verify-PSV/0.1 (+primary source verification for pharmacy compliance; contact: support@2verify.example.com)"
