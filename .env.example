# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance

# --- App --------------------------------------------------------------------
APP_URL=http://localhost:3000
# 32+ random chars; signs the session cookie.  openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
# Admin user created by `make seed` (and kept by `make seed-wipe`).
SEED_ADMIN_EMAIL=admin@sierra-rx.example.com
SEED_ADMIN_NAME="Compliance Admin"
SEED_ADMIN_PASSWORD=admin1234
# Extra recipient for every alert (the compliance lead). Comma-separated.
ALERT_CC=compliance@sierra-rx.example.com

# --- File storage -----------------------------------------------------------
# "s3" (MinIO locally, R2/S3 in prod) or "local" (writes under ./data/files; dev only)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=compliance-evidence
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=600
LOCAL_STORAGE_DIR=./data/files

# --- Email ------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Sierra Compliance <compliance@sierra-rx.example.com>"

# --- External sources (Phase 2) --------------------------------------------
SAM_API_KEY=
